{
  "manifest_version": 3,
  "name": "temo 딸깍",
  "short_name": "temo 딸깍",
  "description": "아이밸런스에 로그인한 상태에서 한 달 치 모아레 검사 리포트를 PDF로 만들어 ZIP 한 개로 저장합니다.",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "tabs",
    "scripting",
    "downloads",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "temo 딸깍 · 모아레 월별 PDF 만들기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
